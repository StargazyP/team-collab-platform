# ===============================
# Database (MySQL)
# ===============================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=user

# ===============================
# Auth (JWT)
# ===============================
JWT_SECRET=your-jwt-secret-min-32-chars

# ===============================
# WebSocket (채널 메시지, 알림)
# ===============================
WS_PORT=8081
# 클라이언트에서 접속할 WebSocket URL (예: wss://your-domain/ws 또는 ws://localhost:8081)
NEXT_PUBLIC_WS_URL=ws://localhost:8081
# 또는 호스트/포트로 분리해서 설정 가능
# NEXT_PUBLIC_WS_HOST=localhost
# NEXT_PUBLIC_WS_PORT=8081

# ===============================
# LiveKit (허들 음성/영상 통화)
# LiveKit Cloud: https://cloud.livekit.io/ 에서 프로젝트 생성 후 키 발급
# 또는 LiveKit 서버 셀프 호스팅: https://docs.livekit.io/deploy/
# ===============================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
